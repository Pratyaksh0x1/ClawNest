# OpenRouter API Configuration (Required)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Firecrawl API Configuration (Optional, for web search & scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Telegram Bot Configuration (Required for Telegram mode)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_user_id_here

# Skills Directories (Optional, semicolon-separated paths)
# SKILLS_DIRS=/path/to/custom/skills
